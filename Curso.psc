Algoritmo Curso
	Definir n1, n2, n3, n4, n5, definitiva Como Real
	
	Escribir "Escribe su primera nota: "
	Leer n1
	
	Escribir "Escribe su Segunda nota: "
	Leer n2
	
	Escribir "Escribe su tercera nota: " 
	Leer n3
	
	Escribir "Escribe su cuarta nota: "
	Leer n4
	
	Escribir "Escribe su quinta nota: "
	Leer n5
	
	definitiva = (n1+ n2+ n3+ n4+ n5) / 5
	
	Escribir "Su definitiva es: ", definitiva
	
	si definitiva > 3.5
		Escribir "Felicidades pasastes el curso" 
	sino
		Escribir "Perdiste el curso"
	FinSi
	
FinAlgoritmo
